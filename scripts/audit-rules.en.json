{
  "description": "Heuristic stale-pattern checks for English docs UI sync.",
  "patterns": [
    {
      "id": "old_web_widgets_label",
      "pattern": "Web\\s*>\\s*Widgets",
      "flags": "g",
      "message": "Use 'Web Widgets' as the current navigation label."
    },
    {
      "id": "old_copilot_action_edit_with_ai",
      "pattern": "Edit with AI",
      "flags": "g",
      "message": "Use the current action label: 'Copilot'."
    },
    {
      "id": "old_copilot_action_ai_edit",
      "pattern": "AI Edit",
      "flags": "g",
      "message": "Use the current action label: 'Copilot'."
    },
    {
      "id": "old_test_button_label",
      "pattern": "\\*\\*Test\\*\\*(?:\\s+button|\\s+in the toolbar)",
      "flags": "g",
      "message": "Use 'Test Agent' for the editor test button label."
    },
    {
      "id": "old_custom_api_tools_route",
      "pattern": "/build/tools/custom-api-tools",
      "flags": "g",
      "message": "Use '/build/tools/custom-api-actions'."
    },
    {
      "id": "old_thinking_sounds_route",
      "pattern": "/build/advanced/thinking-sounds",
      "flags": "g",
      "message": "Use '/build/voice-speech/thinking-sounds'."
    },
    {
      "id": "old_vad_route",
      "pattern": "/build/voice-speech/voice-activity-detection",
      "flags": "g",
      "message": "Use '/build/advanced/vad-turn-detection'."
    },
    {
      "id": "old_dtmf_route",
      "pattern": "/build/advanced/dtmf-collection",
      "flags": "g",
      "message": "Use '/build/advanced/dtmf-controls'."
    },
    {
      "id": "old_voicemail_route",
      "pattern": "/build/advanced/voicemail-detection",
      "flags": "g",
      "message": "Use '/build/advanced/voicemail-handling'."
    },
    {
      "id": "old_anchor_knowledge_tab",
      "pattern": "#knowledge-tab",
      "flags": "g",
      "message": "Use '#knowledge' anchor on the Agent Editor page."
    },
    {
      "id": "old_anchor_deploy_tab",
      "pattern": "#deploy-tab",
      "flags": "g",
      "message": "Use '#deploy' anchor on the Agent Editor page."
    },
    {
      "id": "old_anchor_thinking_ai_model",
      "pattern": "#thinking-ai-model",
      "flags": "g",
      "message": "Link directly to the specific settings page when possible."
    },
    {
      "id": "old_anchor_understanding_voice",
      "pattern": "#understanding-voice",
      "flags": "g",
      "message": "Link directly to the transcriber page when possible."
    },
    {
      "id": "old_conversation_tab_wording",
      "pattern": "General, Prompt, Knowledge, Tools, Conversation, Analytics, Notifications, Privacy, and Deploy",
      "flags": "g",
      "message": "Use 'Call Flow' instead of the stale 'Conversation' tab name."
    },
    {
      "id": "old_conversation_tab_alt",
      "pattern": "Conversation tab",
      "flags": "g",
      "message": "Use 'Call Flow' for the visible tab label in UI descriptions and alt text."
    }
  ]
}
